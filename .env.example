# URL pública HTTPS (sem barra final). localhost é permitido apenas para desenvolvimento.
APP_URL=http://localhost:3000
# Demonstração explícita e independente de credenciais. Desative na instalação real.
DEMO_MODE=true
# Domínios exatos autorizados, separados por vírgula. Sem protocolo ou caminhos.
BITRIX_ALLOWED_DOMAINS=suaempresa.bitrix24.com.br
BITRIX_CLIENT_ID=
BITRIX_CLIENT_SECRET=
# Código retornado por app.info. Em apps locais, normalmente é o próprio client_id.
# Defina explicitamente se o portal retornar um código diferente.
BITRIX_APP_CODE=
# Opcional: token de aplicação fornecido pelo portal; validação adicional do POST.
BITRIX_APPLICATION_TOKEN=
# Opcional: member_id esperado da instalação.
BITRIX_MEMBER_ID=
